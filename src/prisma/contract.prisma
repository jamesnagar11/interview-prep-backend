// use prisma-8

model User {
  id               ObjectId          @id @map("_id")
  name             String
  email            String            @unique
  passwordHash     String
  createdAt        DateTime
  kits             Kit[]
  practiceSessions PracticeSession[]
  mockExams        MockExam[]
}

model Kit {
  id            ObjectId @id @map("_id")
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  // idempotency: hash of (jdText + companyUrl) to catch duplicate submissions
  dedupeHash    String?

  // source
  companyName   String?
  companyUrl    String
  jdText        String
  jdChars       Int?
  role          String?
  location      String?
  daysAvailable Int
  researchedAt  DateTime?

  // company_brief
  briefSummary    String?
  briefWhatTheyDo String?
  briefState      ItemState?

  // top-level role fields
  roleTitle     String?
  roleSeniority String?

  // research bundle persisted for regeneration (JSON stringified)
  research      String?

  // Builder schedule staleness flag
  scheduleStale Boolean?

  status        KitStatus
  failureReason String?
  errorMessage  String?
  result        String?
  coveragePasses Int?

  createdAt     DateTime
  updatedAt     DateTime

  pagesUsed             KitPage[]
  briefSources          BriefSource[]
  responsibilities      Responsibility[]
  uncoveredRequirements UncoveredRequirement[]

  sourcePages      SourcePage[]
  requirements     Requirement[]
  questions        Question[]
  flashcards       Flashcard[]
  scheduleDays     ScheduleDay[]
  practiceSessions PracticeSession[]
  mockExams        MockExam[]

  @@index([userId])
  @@index([dedupeHash])
}

enum KitStatus {
  PENDING
  RUNNING
  DRAFT
  RESEARCHING
  EXTRACTING
  GENERATING
  CHECKING_COVERAGE
  SCHEDULING
  READY
  FAILED
}

model KitPage {
  id    ObjectId @id @map("_id")
  kitId String
  kit   Kit      @relation(fields: [kitId], references: [id])
  url   String
}

model BriefSource {
  id    ObjectId @id @map("_id")
  kitId String
  kit   Kit      @relation(fields: [kitId], references: [id])
  url   String
}

model Responsibility {
  id          ObjectId @id @map("_id")
  kitId       String
  kit         Kit      @relation(fields: [kitId], references: [id])
  description String
}

model UncoveredRequirement {
  id        ObjectId @id @map("_id")
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id])
  stableKey String   // stableKey list, e.g. "r3"
}

model SourcePage {
  id        ObjectId @id @map("_id")
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id])
  url       String
  kind      String   // "hiring" | "about" | "interview_discussion"
  status    String   // "ok" | "skipped" | "failed"
  reason    String?  // e.g. "404", "robots_disallowed", "timeout"
  fetchedAt DateTime
}

model Requirement {
  id        ObjectId @id @map("_id")
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id])
  stableKey String   // "r1" — stable WITHIN this kit, used in output JSON
  text      String
  kind      String   // "technical" | "behavioural" | "domain"
  priority  String   // "must" | "nice"

  questions  QuestionRequirement[]
  flashcards FlashcardRequirement[]

  @@unique([kitId, stableKey])
}

model Question {
  id            ObjectId  @id @map("_id")
  kitId         String
  kit           Kit       @relation(fields: [kitId], references: [id])
  stableKey     String    // "q1"
  category      String    // technical | behavioural | system-design | company-fit
  prompt        String
  answerOutline String
  difficulty    Int       // 1-3
  state         ItemState // GENERATED | EDITED | PINNED
  orderIndex    Int       // for manual reordering within category

  requirements  QuestionRequirement[]
  scheduleSlots ScheduleDayQuestion[]

  @@unique([kitId, stableKey])
}

model QuestionRequirement {
  id            ObjectId    @id @map("_id")
  questionId    String
  requirementId String
  question      Question    @relation(fields: [questionId], references: [id])
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@unique([questionId, requirementId])
}

model Flashcard {
  id         ObjectId  @id @map("_id")
  kitId      String
  kit        Kit       @relation(fields: [kitId], references: [id])
  stableKey  String    // "f1"
  front      String
  back       String
  state      ItemState
  orderIndex Int

  requirements FlashcardRequirement[]
  attempts     PracticeAttempt[]
}

model FlashcardRequirement {
  id            ObjectId    @id @map("_id")
  flashcardId   String
  requirementId String
  flashcard     Flashcard   @relation(fields: [flashcardId], references: [id])
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  @@unique([flashcardId, requirementId])
}

enum ItemState {
  GENERATED // untouched model output — safe to overwrite on regeneration
  EDITED    // user changed text — must survive regeneration
  PINNED    // user explicitly locked it — must survive regeneration + excluded from auto-replace
}

model ScheduleDay {
  id        ObjectId @id @map("_id")
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id])
  dayNumber Int
  focus     String
  minutes   Int

  questions ScheduleDayQuestion[]

  @@unique([kitId, dayNumber])
}

model ScheduleDayQuestion {
  id            ObjectId    @id @map("_id")
  scheduleDayId String
  questionId    String
  position      Int
  scheduleDay   ScheduleDay @relation(fields: [scheduleDayId], references: [id])
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([scheduleDayId, questionId])
}

model PracticeSession {
  id        ObjectId @id @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kitId     String
  kit       Kit      @relation(fields: [kitId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  attempts  PracticeAttempt[]

  @@index([userId, kitId])
}

model PracticeAttempt {
  id          ObjectId        @id @map("_id")
  sessionId   String
  session     PracticeSession @relation(fields: [sessionId], references: [id])
  flashcardId String
  flashcard   Flashcard       @relation(fields: [flashcardId], references: [id])
  confidence  Int?            // e.g. 1 (low) – 10 (high), null if skipped
  skipped     Boolean?
  attemptedAt DateTime

  @@index([sessionId])
  @@index([flashcardId])
}

// Mock Exam — records a full mock question session with per-question ratings
model MockExam {
  id          ObjectId          @id @map("_id")
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  kitId       String
  kit         Kit               @relation(fields: [kitId], references: [id])
  title       String            // e.g. "Full Mock Exam" or "Day 2 Practice Test"
  startedAt   DateTime
  finishedAt  DateTime?
  durationSec Int?              // elapsed time in seconds
  aiReport    String?           // JSON stringified AI coaching report
  questions   MockExamQuestion[]

  @@index([userId, kitId])
}

model MockExamQuestion {
  id            ObjectId  @id @map("_id")
  mockExamId    String
  mockExam      MockExam  @relation(fields: [mockExamId], references: [id])
  questionId    String    // stableKey e.g. "q1"
  questionText  String
  answerOutline String
  category      String
  difficulty    Int
  userNotes     String?   // user's typed response/notes
  confidence    Int?      // 1-10 self-rating, null if not rated
  flagged       Boolean?
  position      Int       // order in the exam

  @@index([mockExamId])
}